{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reqops.local/contracts/ai-v2.schema.json",
  "title": "ReqOps AI v2 artifact batch",
  "type": "object",
  "required": ["schemaVersion", "issue", "outputs", "engine"],
  "properties": {
    "schemaVersion": {"const": 2},
    "issue": {
      "type": "object",
      "required": ["title", "symptom", "improvementReq", "changeScope", "constraintsNote", "beforeState", "afterState"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "symptom": {"type": ["string", "null"]},
        "improvementReq": {"type": ["string", "null"]},
        "changeScope": {"type": ["string", "null"]},
        "constraintsNote": {"type": ["string", "null"]},
        "beforeState": {"type": ["string", "null"]},
        "afterState": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "outputs": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["type", "status", "content", "errors"],
        "properties": {
          "type": {"enum": ["VOC", "FUNCTIONAL", "NONFUNCTIONAL", "DETAIL_DESIGN"]},
          "status": {"enum": ["SUCCEEDED", "FAILED"]},
          "content": {"type": ["object", "null"]},
          "errors": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "engine": {"enum": ["rule", "internal", "gemini"]}
  },
  "additionalProperties": false
}
