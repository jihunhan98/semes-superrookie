# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 커밋되지 않는다.
#
#   cp .env.example .env
#
# provider는 반드시 명시한다. 키 유무만으로 외부 전송을 선택하지 않는다.
AI_PROVIDER=internal

# 사내 LLM API 주소. 접근 제한과 인증 정책은 서버 운영 설정에서 관리한다.

# 사내 LLM API 서비스 (OpenAI 호환). /v1 까지 포함한 주소.
LLM_API_BASE=http://23.43.51.216:6100/v1
# 사내 서버가 서빙하는 모델명
LLM_API_MODEL=auto
# 사내 서비스는 인증이 없어 EMPTY
LLM_API_KEY=EMPTY
LLM_API_TIMEOUT=90

# AI_PROVIDER=gemini일 때만 사용한다. 실제 키는 .env/환경변수에만 둔다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 등록 화면 로딩 UI 테스트용 인위적 지연(초)
# ANALYZE_DELAY=3
