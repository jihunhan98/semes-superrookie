# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 커밋되지 않는다.
#
#   cp .env.example .env
#
# provider는 반드시 명시한다. 키 유무만으로 외부 전송을 선택하지 않는다.
AI_PROVIDER=rule

# 사내 LLM API 주소는 사내망 정보라 저장소에 두지 않는다.
# 실제 주소·모델명은 팀 내부(사내 위키/담당자)에서 받아 아래에 채운다.
# 비워두면 LLM 호출 자체를 건너뛰고 규칙 기반 결과만 사용한다(engine=rule).

# 사내 LLM API 서비스 (OpenAI 호환). /v1 까지 포함한 주소.
LLM_API_BASE=http://<사내-LLM-호스트>:<포트>/v1
# 사내 서버가 서빙하는 모델명
LLM_API_MODEL=gpt-4
# 사내 서비스는 인증이 없어 EMPTY
LLM_API_KEY=EMPTY
LLM_API_TIMEOUT=90

# AI_PROVIDER=gemini일 때만 사용한다. 실제 키는 .env/환경변수에만 둔다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 등록 화면 로딩 UI 테스트용 인위적 지연(초)
# ANALYZE_DELAY=3
