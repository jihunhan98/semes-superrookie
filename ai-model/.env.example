# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 커밋되지 않는다.
#
#   cp .env.example .env
#
# 사내 LLM API 주소는 사내망 정보라 저장소에 두지 않는다.
# 실제 주소·모델명은 팀 내부(사내 위키/담당자)에서 받아 아래에 채운다.
# 비워두면 이 엔진은 없는 것으로 보고 Ollama → 규칙 기반 순으로 내려간다.

# 사내 LLM API 서비스 (OpenAI 호환). /v1 까지 포함한 주소.
LLM_API_BASE=http://<사내-LLM-호스트>:<포트>/v1
# 사내 서버가 서빙하는 모델명
LLM_API_MODEL=gpt-4
# 사내 서비스는 인증이 없어 EMPTY
LLM_API_KEY=EMPTY

# 로컬 Ollama (사내 LLM 을 못 쓸 때)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct

# auto | llm-api | ollama | rule — 엔진을 강제하고 싶을 때
# LLM_BACKEND=auto

# 등록 화면 로딩 UI 테스트용 인위적 지연(초)
# ANALYZE_DELAY=3
