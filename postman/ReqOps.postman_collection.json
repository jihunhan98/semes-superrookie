{
  "info": {
    "name": "ReqOps API",
    "description": "기능 1(회원가입·로그인·프로젝트) + 기능 2(요구사항 목록·최초 등록·AI 검토) API 테스트 컬렉션. 세션/토큰 없음 — 모든 API는 요청 바디/쿼리에 userId를 직접 넘긴다.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:41010",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "1",
      "type": "string",
      "description": "회원가입/로그인 응답의 id 값을 넣는다."
    },
    {
      "key": "projectId",
      "value": "1",
      "type": "string",
      "description": "프로젝트 생성 응답의 id 값을 넣는다."
    },
    {
      "key": "projectToken",
      "value": "",
      "type": "string",
      "description": "프로젝트 생성/토큰 재발급 응답의 token 값을 넣는다."
    },
    {
      "key": "requirementId",
      "value": "1",
      "type": "string",
      "description": "요구사항 등록 응답의 id 값을 넣는다."
    },
    {
      "key": "aiBaseUrl",
      "value": "http://localhost:41020",
      "type": "string",
      "description": "AI 서버(FastAPI) 주소. 백엔드의 app.ai.base-url과 같아야 한다."
    }
  ],
  "item": [
    {
      "name": "회원가입 성공",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/signup",
          "host": ["{{baseUrl}}"],
          "path": ["api", "signup"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"empNo\": \"20213456\",\n  \"name\": \"한지훈\",\n  \"dept\": \"VCS 개발파트\",\n  \"password\": \"secret123\"\n}"
        }
      },
      "response": []
    },
    {
      "name": "회원가입 실패 - 사번 중복",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/signup",
          "host": ["{{baseUrl}}"],
          "path": ["api", "signup"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"empNo\": \"20213456\",\n  \"name\": \"한지훈\",\n  \"dept\": \"VCS 개발파트\",\n  \"password\": \"secret123\"\n}"
        },
        "description": "'회원가입 성공' 요청을 먼저 실행한 뒤 같은 empNo로 다시 보내면 409 등 중복 오류가 나야 한다."
      },
      "response": []
    },
    {
      "name": "회원가입 실패 - 필수값 누락",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/signup",
          "host": ["{{baseUrl}}"],
          "path": ["api", "signup"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"empNo\": \"\",\n  \"name\": \"\",\n  \"dept\": \"VCS 개발파트\",\n  \"password\": \"\"\n}"
        },
        "description": "@NotBlank 검증 확인용 — 400과 함께 유효성 오류가 나야 한다."
      },
      "response": []
    },
    {
      "name": "로그인 성공",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "login"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"empNo\": \"20213456\",\n  \"password\": \"secret123\"\n}"
        },
        "description": "'회원가입 성공' 요청을 먼저 실행해서 계정을 만든 뒤 테스트한다."
      },
      "response": []
    },
    {
      "name": "로그인 실패 - 비밀번호 불일치",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "login"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"empNo\": \"20213456\",\n  \"password\": \"wrong-password\"\n}"
        }
      },
      "response": []
    },
    {
      "name": "로그인 실패 - 존재하지 않는 사번",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "login"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"empNo\": \"99999999\",\n  \"password\": \"secret123\"\n}"
        }
      },
      "response": []
    },
    {
      "name": "프로젝트",
      "item": [
        {
          "name": "프로젝트 생성",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/projects",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"name\": \"VCS 태스크 할당\",\n  \"customer\": \"삼성전자 EDS 설비공정그룹\",\n  \"description\": \"newAMOS로부터 Task를 받아 AMR에 할당하는 영역\"\n}"
            },
            "description": "응답의 id → projectId 변수에, token → projectToken 변수에 넣어두면 아래 요청들에 바로 쓸 수 있다."
          },
          "response": []
        },
        {
          "name": "프로젝트 목록",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/projects?userId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects"],
              "query": [{ "key": "userId", "value": "{{userId}}" }]
            }
          },
          "response": []
        },
        {
          "name": "프로젝트 참여 (Open Project · 토큰)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/projects/join",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", "join"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"token\": \"{{projectToken}}\"\n}"
            },
            "description": "다른 사번으로 회원가입한 userId로 시도하면 Member로 합류하는 걸 확인할 수 있다."
          },
          "response": []
        },
        {
          "name": "프로젝트 참여 실패 - 잘못된 토큰",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/projects/join",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", "join"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"token\": \"req_prj_invalid0000000000000000\"\n}"
            },
            "description": "400과 함께 유효하지 않은 토큰 오류가 나야 한다."
          },
          "response": []
        },
        {
          "name": "프로젝트 상세 (설정 화면)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}?userId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", "{{projectId}}"],
              "query": [{ "key": "userId", "value": "{{userId}}" }]
            },
            "description": "Owner로 조회하면 token이 채워지고, Member로 조회하면 token은 null."
          },
          "response": []
        },
        {
          "name": "프로젝트 기본정보 수정",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", "{{projectId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"name\": \"VCS 태스크 할당 (수정)\",\n  \"customer\": \"삼성전자 EDS 설비공정그룹\",\n  \"description\": \"설명 수정\"\n}"
            },
            "description": "Owner가 아니면 403이 나야 한다."
          },
          "response": []
        },
        {
          "name": "프로젝트 토큰 재발급",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/token/reissue?userId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", "{{projectId}}", "token", "reissue"],
              "query": [{ "key": "userId", "value": "{{userId}}" }]
            },
            "description": "이전 토큰은 폐기되어 더 이상 참여에 쓸 수 없다. Owner가 아니면 403."
          },
          "response": []
        }
      ]
    },
    {
      "name": "요구사항",
      "description": "기능 2 — 목록 · 최초 등록 · 상세 · AI 재분석. 등록은 저장 후 AI 검토까지 마치고 응답하므로 몇 초 걸릴 수 있다.",
      "item": [
        {
          "name": "요구사항 최초 등록",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/requirements",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", "{{projectId}}", "requirements"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"reqKey\": \"req-am-03\",\n  \"content\": \"AMR 매칭 시 가용한 AMR 중 가장 가까운 AMR을 선택한다. 단, 배터리가 부족하면 제외하고 빠르게 재할당한다.\",\n  \"requesterDept\": \"삼성전자 EDS · 설비공정그룹\",\n  \"requesterName\": \"김민석 책임\"\n}"
            },
            "description": "201 CREATED. 응답 본문은 상세 응답과 같은 모양이며 findings[]와 aiDraftContent가 이미 채워져 있다.\n- aiDraftContent: AI 제안이 반영된 문장. 프론트는 이 값을 '확정될 본문' 입력칸의 초기값으로 쓴다.\n- aiEngine: llm-api(사내 LLM이 응답함) | rule(LLM은 못 썼지만 규칙 검토는 돌았음) | unavailable(AI 서버 자체 미응답). AI 서버가 죽어 있어도 등록 자체는 성공한다. rule 은 '검토를 못 했다'가 아니므로 findings 가 여러 건일 수 있다.\n응답의 id를 requirementId 변수에 넣어두면 아래 요청에 바로 쓸 수 있다."
          },
          "response": []
        },
        {
          "name": "요구사항 등록 실패 - ID 중복",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/requirements",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", "{{projectId}}", "requirements"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"reqKey\": \"req-am-03\",\n  \"content\": \"같은 프로젝트에 같은 요구사항 ID를 다시 등록한다.\"\n}"
            },
            "description": "'요구사항 최초 등록'을 먼저 실행한 뒤 같은 reqKey로 보내면 409가 나야 한다."
          },
          "response": []
        },
        {
          "name": "요구사항 등록 실패 - 필수값 누락",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/requirements",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", "{{projectId}}", "requirements"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"reqKey\": \"\",\n  \"content\": \"\"\n}"
            },
            "description": "reqKey·content는 @NotBlank — 400과 함께 유효성 오류가 나야 한다."
          },
          "response": []
        },
        {
          "name": "요구사항 목록",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/requirements?userId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", "{{projectId}}", "requirements"],
              "query": [{ "key": "userId", "value": "{{userId}}" }]
            },
            "description": "등록 최신순. 각 행은 reqKey·content·state/stateLabel·version·assigneeName·findingCount를 담는다. 상태/담당자/검색 필터는 프론트에서 처리한다."
          },
          "response": []
        },
        {
          "name": "담당자 필터 후보",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/requirements/assignees?userId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", "{{projectId}}", "requirements", "assignees"],
              "query": [{ "key": "userId", "value": "{{userId}}" }]
            },
            "description": "프로젝트 멤버 전원. 요구사항이 하나도 없어도 목록 화면의 담당자 칩은 채워진다."
          },
          "response": []
        },
        {
          "name": "요구사항 상세",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/requirements/{{requirementId}}?userId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", "{{projectId}}", "requirements", "{{requirementId}}"],
              "query": [{ "key": "userId", "value": "{{userId}}" }]
            },
            "description": "content(등록 원문)와 aiDraftContent(AI 제안 반영본)를 함께 내려준다. 'AI 제안 적용' API는 따로 없다 — 프론트가 aiDraftContent를 본문 입력칸의 초기값으로 쓰고, 사용자는 그 텍스트를 그대로 두거나 직접 고친다."
          },
          "response": []
        },
        {
          "name": "요구사항 상세 실패 - 없는 ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/requirements/999999?userId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", "{{projectId}}", "requirements", "999999"],
              "query": [{ "key": "userId", "value": "{{userId}}" }]
            },
            "description": "404가 나야 한다."
          },
          "response": []
        },
        {
          "name": "AI 재분석",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/requirements/{{requirementId}}/analyze?userId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", "{{projectId}}", "requirements", "{{requirementId}}", "analyze"],
              "query": [{ "key": "userId", "value": "{{userId}}" }]
            },
            "description": "화면의 '↻ 다시 분석'. 기존 findings를 지우고 다시 채운다. 등록 시 AI 서버가 죽어 있어 aiEngine이 unavailable이었거나, LLM만 못 붙어 rule이었다면 이 API로 다시 시도한다."
          },
          "response": []
        },
        {
          "name": "확정본 수정 - AI 검토 (변경분만)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/requirements/{{requirementId}}/diff-analyze",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", "{{projectId}}", "requirements", "{{requirementId}}", "diff-analyze"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"content\": \"AMR 매칭 시 IDLE 상태이며 SoC 최소값 이상인 AMR 중 맵 경로상 맨해튼 거리 기준 최단 경로에 있는 AMR을 선택한다. 처리 우선순위는 req-ta-01과 동일하게 SoC 높은 순으로 정한다.\",\n  \"reason\": \"req-ta-01과 우선순위 기준이 달라 충돌합니다. 두 요구사항 모두 SoC 높은 순으로 통일해주세요. — 삼성전자 EDS 김민석 책임\"\n}"
            },
            "description": "이미 확정된 요구사항을 고칠 때 쓴다. 확정본 대비 바뀐 부분과 사유만 AI가 본다 — 이미 합의된 나머지 문장은 다시 건드리지 않는다.\n- baseContent(확정본)는 보내지 않는다. 서버가 DB에서 가져온다.\n- 응답의 scope 가 diff 면 변경분만 본 것이다.\n- 실행하면 상태가 '변경중'으로 바뀐다. 버전은 재확정 전까지 그대로."
          },
          "response": []
        },
        {
          "name": "고객 합의 기록",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/requirements/{{requirementId}}/consensus",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", "{{projectId}}", "requirements", "{{requirementId}}", "consensus"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"method\": \"대면 미팅\",\n  \"customerContact\": \"삼성전자 EDS 김민석 책임\",\n  \"agreedOn\": \"2026-08-16\",\n  \"note\": \"가용/최단거리 판정 기준을 위 문장대로 확정하기로 합의. req-ta-01 우선순위 상충은 별도 건으로 후속 협의.\",\n  \"agreedContent\": \"AMR 매칭 시 IDLE 상태이며 SoC 최소값 이상인 AMR 중 맵 경로상 맨해튼 거리 기준 최단 경로에 있는 AMR을 선택한다.\"\n}"
            },
